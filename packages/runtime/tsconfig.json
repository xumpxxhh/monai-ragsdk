{
  "extends": "../../tsconfig.json",
  "references": [
    { "path": "../core" },
    { "path": "../observability" },
    { "path": "../indexing" }
  ],
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "src/**/*.js", "src/**/*.d.ts"]
}
