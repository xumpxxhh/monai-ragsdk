{
  "name": "@monai-ragsdk/runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @monai-ragsdk/core build && pnpm --filter @monai-ragsdk/observability build && tsc -p tsconfig.json",
    "demo": "pnpm run build && tsx demo/minimal-runtime.ts",
    "demo:minimal": "pnpm run build && tsx demo/minimal-runtime.ts",
    "demo:custom": "pnpm run build && tsx demo/custom-runtime.ts",
    "test": "pnpm run build && vitest run __tests__",
    "test:watch": "vitest __tests__"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@monai-ragsdk/core": "workspace:*",
    "@monai-ragsdk/observability": "workspace:*",
    "@monai-ragsdk/indexing": "workspace:*"
  }
}
