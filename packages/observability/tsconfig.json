{
  "extends": "../../tsconfig.json",
  "references": [{ "path": "../core" }],
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "paths": {
      "@monai-ragsdk/core": ["../core/dist/index.d.ts"],
      "@monai-ragsdk/core/*": ["../core/dist/*"]
    },
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "src/**/*.js", "src/**/*.d.ts"]
}
