{
  "name": "@monai-ragsdk/indexing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "demo": "pnpm run build && tsx demo/run-indexing.ts",
    "demo:extensions": "pnpm run build && tsx demo/extension-components.ts",
    "demo:incremental": "pnpm run build && tsx demo/incremental-indexing.ts",
    "demo:run-indexing": "pnpm run build && tsx demo/run-indexing.ts",
    "test": "vitest run __tests__",
    "test:watch": "vitest __tests__"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@monai-ragsdk/core": "workspace:*",
    "@monai-ragsdk/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
