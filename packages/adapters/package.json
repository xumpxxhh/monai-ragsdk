{
  "name": "@monai-ragsdk/adapters",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "demo": "pnpm run build && tsx demo/langchain-adapters.ts",
    "demo:chroma-store": "pnpm run build && tsx demo/chroma-store.ts",
    "demo:langchain-adapters": "pnpm run build && tsx demo/langchain-adapters.ts",
    "demo:langchain-extensions": "pnpm run build && tsx demo/langchain-extensions.ts",
    "demo:langchain-runtime": "pnpm run build && tsx demo/langchain-runtime.ts",
    "demo:pgvector-store": "pnpm run build && tsx demo/pgvector-store.ts",
    "demo:pgvector-runtime": "pnpm run build && tsx demo/pgvector-runtime.ts",
    "demo:openai-adapters": "pnpm run build && tsx demo/openai-adapters.ts",
    "demo:ollama-adapters": "pnpm run build && tsx demo/ollama-adapters.ts",
    "test": "vitest run __tests__",
    "test:watch": "vitest __tests__"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@langchain/classic": "catalog:",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "catalog:",
    "@langchain/textsplitters": "^1.0.1",
    "@monai-ragsdk/core": "workspace:*",
    "@monai-ragsdk/indexing": "workspace:*",
    "@monai-ragsdk/runtime": "workspace:*",
    "cheerio": "^1.1.2",
    "chromadb": "^3.4.3",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
