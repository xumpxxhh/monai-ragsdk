{
  "name": "@monai-ragsdk/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json --pretty false",
    "cli": "pnpm run build && node dist/index.js",
    "cli:dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@langchain/classic": "catalog:",
    "@monai-ragsdk/adapters": "workspace:*",
    "@monai-ragsdk/core": "workspace:*",
    "@monai-ragsdk/indexing": "workspace:*",
    "@monai-ragsdk/observability": "workspace:*",
    "@monai-ragsdk/runtime": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
