{
  "name": "monai-ragsdk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "build:web": "turbo run build --filter=@monai-ragsdk/web",
    "example": "turbo run build --filter=@monai-ragsdk/example && pnpm --filter @monai-ragsdk/example start",
    "dev:web": "turbo run dev --filter=@monai-ragsdk/web",
    "dev:server": "turbo run dev --filter=@monai-ragsdk/server",
    "dev:knowledge": "turbo run dev --filter=@monai-ragsdk/knowledge",
    "dev:server:debug": "pnpm --filter @monai-ragsdk/server dev:debug",
    "build:server": "turbo run build --filter=@monai-ragsdk/server",
    "start:web": "pnpm --filter @monai-ragsdk/web start",
    "test:core": "turbo run test --filter=@monai-ragsdk/core",
    "test:indexing": "turbo run test --filter=@monai-ragsdk/indexing",
    "test:adapters": "turbo run test --filter=@monai-ragsdk/adapters",
    "test:runtime": "turbo run test --filter=@monai-ragsdk/runtime",
    "test:integration": "pnpm run build && tsx tests/integration/runtime-adapters-query-chain.ts && tsx tests/integration/indexing-runtime-query-chain.ts",
    "check": "pnpm run check-types && pnpm run test",
    "smoke": "pnpm run build && tsx tests/smoke/runtime-adapters-query-chain.ts && tsx tests/smoke/indexing-runtime-query-chain.ts",
    "verify": "pnpm run check && pnpm run test:integration && pnpm run smoke"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@langchain/core": "catalog:",
    "@types/node": "catalog:",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "catalog:",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "typescript-eslint": "^8.46.0",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "typescript": "$typescript",
      "@types/node": "$@types/node",
      "vitest": "$vitest",
      "tsx": "$tsx",
      "@langchain/core": "$@langchain/core"
    }
  }
}
